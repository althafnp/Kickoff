{{> admin/header}}



<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
</head>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Products</h2>
        </div>
    </div>

    <header class="card-header text-center mb-20">
        <form action="" method="get" class="d-inline">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="input-group input-group-sm border border-1 border-grey rounded-pill">
                            <input type="text" class="form-control border-0 rounded-pill" placeholder="Search Products"
                            name="search" />
                            <button class="btn" type="submit">Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </header>
    <div class="product-container">
        <!-- Card layout for mobile -->
        <div class="d-block d-md-none">
            <div class="row">
                {{#each product}}
                <div class="col-12 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">{{productName}}</h5>
                            <p class="card-text"><strong>Category:</strong> {{category.categoryType}}</p>
                            <p class="card-text"><strong>Sale Price:</strong> ₹{{salePrice}}</p>
                            <p class="card-text"><strong>Offer Price:</strong> {{productOffer}}%</p>
                            <div>
                                {{#if (eq productOffer 0)}}
                                <button class="btn btn-info text-white" onclick="addOffer('{{_id}}')"
                                    style="width: 100%;">Add Offer</button>
                                {{else}}
                                <button class="btn btn-info text-white" onclick="removeOffer('{{_id}}')"
                                    style="width: 100%;">Remove</button>
                                {{/if}}
                            </div>
                            <p class="card-text"><strong>Quantity:</strong>
                                {{#each variant}}
                                {{size}} - {{stock}}&nbsp;&nbsp;&nbsp;
                                {{/each}}
                            </p>
                            <div class="d-flex justify-content-between">
                                {{#if isBlocked}}
                                <a href="/admin/products/unblockProduct?id={{_id}}" style="text-decoration: none;">
                                    <button class="btn btn-success" style="width: 100%%;">Unblock</button>
                                </a>
                                {{else}}
                                <a href="/admin/products/blockProduct?id={{_id}}" style="text-decoration: none;">
                                    <button class="btn btn-danger" style="width: 100%;">Block</button>
                                </a>
                                {{/if}}
                                <a href="/admin/products/editProduct?id={{_id}}" class="text-white"
                                    style="text-decoration: none;">
                                    <button class="btn btn-info" style="width: 100%;">Edit</button>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <!-- Table layout for larger screens -->
        <div class="d-none d-md-block">
            <div class="right mt-5">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col"><b>Product name</b></th>
                            <th scope="col"><b>Category</b></th>
                            <th scope="col"><b>Sale Price</b></th>
                            <th scope="col"><b>Offer Price</b></th>
                            <th scope="col"><b>Offer Action</b></th>
                            <th scope="col"><b>Quantity</b></th>
                            <th scope="col"><b>Action</b></th>
                            <th scope="col"><b>Edit</b></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each product}}
                        <tr>
                            <td>{{productName}}</td>
                            <td>{{category.categoryType}}</td>
                            <td>₹{{salePrice}}</td>
                            <td>{{productOffer}}%</td>
                            <td>
                                {{#if (eq productOffer 0)}}
                                <button class="btn btn-info text-white" onclick="addOffer('{{_id}}')"
                                    style="width: 100px;">Add Offer</button>
                                {{else}}
                                <button class="btn btn-info text-white" onclick="removeOffer('{{_id}}')"
                                    style="width: 100px;">Remove</button>
                                {{/if}}
                            </td>
                            <td>
                                {{#each variant}}
                                {{size}}-{{stock}}&nbsp;&nbsp;&nbsp;
                                {{/each}}
                            </td>
                            <td>
                                {{#if isBlocked}}
                                <a href="/admin/products/unblockProduct?id={{_id}}" style="text-decoration: none;">
                                    <button class="btn btn-success text-white" style="width: 80px;">Unblock</button>
                                </a>
                                {{else}}
                                <a href="/admin/products/blockProduct?id={{_id}}" style="text-decoration: none;">
                                    <button class="btn btn-danger" style="width: 80px;">Block</button>
                                </a>
                                {{/if}}
                            </td>
                            <td>
                                <a href="/admin/products/editProduct?id={{_id}}" class="text-white"
                                    style="text-decoration: none;">
                                    <button class="btn btn-info text-white" style="width: 80px;">Edit</button>
                                </a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="container mt-3" style="display: flex; justify-content: center; align-items: center">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                {{#each pages}}
                <li class="page-item {{#if (eq this ../currentPage)}} active {{/if}}">
                    <a href="?page={{this}}" class="page-link"> {{this}} </a>
                </li>
                {{/each}}
            </ul>
        </nav>
    </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>


<script>

    async function addOffer(productId) {
        const { value: amount } = await Swal.fire({
            title: 'Offer in percentage',
            input: 'number',
            inputLabel: 'percentage',
            inputPlaceholder: '%',
            inputValidator: (value) => {
                if (!value) {
                    return 'Please enter a percentage value!';
                }
                if (isNaN(value) || value < 0 || value > 100) {
                    return 'Please enter a valid percentage between 1 and 100!';
                }
            }
        })

        $.ajax({
            url: '/admin/addProductOffer',
            method: 'POST',
            data: {
                percentage: amount,
                productId: productId
            },
            success: (response) => {
                if (response.status == true) {
                    location.reload();
                    Swal.fire('Offer Added')
                }
            },
            error: function (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error Updating Status'
                })
            }
        })
    }


    function removeOffer(productId) {
        try {
            Swal.fire({
                title: 'Remove Offer',
                text: 'Are you sure You want to remove the offer?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: 'd33',
                confirmButtonText: 'Yes, remove it!',
                timer: 5000,
                timerProgressBar: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/admin/removeProductOffer',
                        method: 'POST',
                        data: {
                            productId: productId
                        },
                        success: (response) => {
                            if (response.status == true) {
                                Swal.fire('Removed');
                                location.reload()
                            }
                            else if (response.status == false) {
                                Swal.fire('Failed to remove')
                            }
                            else {
                                alert('Failed')
                            }
                        }
                    })
                }
            })
        }
        catch (error) {
            console.log(error)
        }
    }

</script>



{{> admin/footer}}