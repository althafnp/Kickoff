{{> admin/header}}



<style>
    h2,
    h4 {
        font-weight: bold;
    }

    .order-summary,
    .shipping-payment-section {
        margin-bottom: 30px;
    }

    .shipping-payment-section {
        display: flex;
        justify-content: space-between;
    }

    .cancel-btn {
        margin-top: 20px;
    }

    .table-responsive {
        margin-top: 20px;
    }

    .table thead th {
        background-color: #f8f9fa;
    }

    .shipping-payment-section {
        padding: 15px;
        margin-bottom: 20px;
    }

    .order-summary {
        border: 1px solid #ccc;
        padding: 15px;
        margin-bottom: 15px;
        border-radius: 5px;
        background-color: #f9f9f9;
    }

    .shipping-address {
        width: 55rem;
        background-color: #e7f3ff;
    }

    .payment-details {
        width: 23rem;
        background-color: #fff3e0;
    }

    .continue-payment-btn {
        color: white;
        margin-top: -40px;
        position: absolute;
    }

    .btn {
        padding: 5px 10px !important;
        font-size: 16px;
    }

    @media (max-width: 768px) {
        .shipping-payment-section {
            flex-direction: column;
            align-items: center;
        }

        .shipping-address,
        .payment-details {
            width: 100%;
            margin-bottom: 15px;
        }

        .continue-payment-btn {
            position: static;
            width: 100%;
            margin-top: 10px;
        }

        .btn {
            padding: 8px 16px !important;
            font-size: 14px !important;
        }
    }

    @media (max-width: 576px) {
        .shipping-address {
            padding: 10px;
        }

        .payment-details {
            padding: 10px;
        }

        .table-responsive {
            font-size: 14px;
        }

        .cancel-btn,
        .return-btn {
            width: 100%;
            margin-top: 10px;
        }

        h2,
        h4 {
            font-size: 18px;
        }

        .table thead th,
        .table tbody td {
            font-size: 14px;
        }

        .btn {
            padding: 3px 6px !important;
            font-size: 12px !important;
            width: 8rem !important;
        }
    }
    .order-items {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .order-item {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        background: #fff;
    }
    .product-cart-item {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
    }
    .product_cartitem_pic {
        width: 5rem;
    }
    .product_cartitem_text {
        margin-left: 10px;
    }
    .order-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .quantity, .price {
        font-weight: bold;
    }
    @media (min-width: 768px) {
        .order-item {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
        .order-details {
            flex-direction: row;
        }
    }
</style>




<div class="container mt-5">

    <!-- Order ID and Title -->
    <div class="d-flex justify-content-between align-items-center mb-3" style="font-weight: 500;">
        <span>
            Ordered On : {{formatDate order.createdOn}} | Order Id : {{order.orderId}}
        </span>
    </div>


    <div class="shipping-payment-section border-1">
        <div class="order-summary shipping-address">
            <h4>Shipping Address</h4><br>
            <p class="mb-1" style="font-weight:500;"> Name : {{usedAddress.name}}</p>
            <p class="mb-1" style="font-weight:500;"> Phone : {{usedAddress.phone}}</p>
            <p class="mb-1" style="font-weight:500;">HouseNo : {{usedAddress.houseNo}}</p>
            <p class="mb-1" style="font-weight:500;">City : {{usedAddress.city}}</p>
            <p class="mb-1" style="font-weight:500;">Landmark : {{usedAddress.landmark}}</p>
            <p class="mb-1" style="font-weight:500;">State : {{usedAddress.state}}</p>
            <p class="mb-1" style="font-weight:500;">Pincode: {{usedAddress.pincode}}</p>
        </div>

        <div class="order-summary payment-details p-3 border rounded bg-light">
            <h4 class="mb-0">Order Summary :</h4><br>
            <h6>
                Payment Method:{{#if (eq order.paymentMethod "razorpay")}}RazorPay{{else}}Cash On Delivery{{/if}}
            </h6>
            {{#if (eq order.paymentStatus "Paid")}}
            <span>Payment Status : <span style="color: green;">Paid</span></span>
            {{else}}
            <span>Payment Status : <span style="color: red;">Failed</span></span>
            {{/if}}
            <p class="{{#if (eq order.status 'returned')}}text-danger{{/if}}">
                Order Status : {{order.status}}
            </p>


            
            <div class="d-flex justify-content-between">
                <span>Total Price:</span>
                <span>₹{{order.totalPrice}}</span>
            </div>
            {{#if order.couponApplied}}
            <div class="d-flex justify-content-between">
                <span>Coupon Offer %:</span>
                <span>{{order.coupon.offer}}%</span>
            </div>
            <div>
                <span style="color: green; font-weight: bold">User Saved ₹{{order.discount}}</span>
            </div>
            {{/if}}
            <hr>
            <div class="d-flex justify-content-between">
                <span>Final Amount:</span>
                <span>₹{{order.finalAmount}}</span>
            </div>
        </div>
    </div>



    <h4>Items Ordered</h4>
    <div class="table-responsive">
    <div class="order-items">
        {{#each order.orderedItems}}
        <div class="order-item" style="margin-bottom: 1rem;">
            <div class="product-cart-item">
                <div class="product_cartitem_pic">
                    <img src="/uploads/re-image/{{this.product.productImage.[0]}}" alt="">
                </div>
                <div class="product_cartitem_text">
                    <h6>{{this.product.productName}} ({{size}})</h6>
                    <h6>₹ {{this.product.salePrice}}</h6>
                </div>
            </div>
            <div class="order-details">
                <div class="quantity">
                    <span>Quantity: {{quantity}}</span>
                </div>
            </div>
            <div class="order-details">
                <div class="price">
                    <span>Price: ₹{{price}}</span>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

    <div class="d-flex justify-content-between" style="margin-bottom: 4rem;">
        <a href="/admin/orders" class="btn btn-secondary">Back to Orders</a>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


{{> admin/footer}}