{{> user/header}}



<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Coupons</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <span>Coupons</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="order-history spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h4 style="margin-bottom: 2rem;">Available Coupons</h4>
                {{#if (eq coupon.length 0)}}
                <h4 style="color: red; text-align: center">No Coupons Available</h4>
                {{else}}
                <div class="order__table">
                    <table class="d-none d-lg-table" style="width: 100%">
                        <thead>
                            <tr>
                                <th>Coupon Code</th>
                                <th>Offer</th>
                                <th>Minimum Price</th>
                                <th>Maximum Price</th>
                                <th>Valid Till</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each coupon}}
                            <tr style="height: 3rem;">
                                <td style="font-weight: bold;">{{code}}</td>
                                <td style="color: green; font-weight: bold;">{{couponOffer}}%</td>
                                <td>{{minAmount}}</td>
                                <td>{{maxAmount}}</td>
                                <td>{{formatDate expireOn}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>

                    <div class="d-lg-none">
                        {{#each coupon}}
                        <div class="card mb-2">
                            <div class="card-body">
                                <h5 class="card-title" style="font-weight: bold;">Coupon Code: {{code}}</h5>
                                <p class="card-text" style="color: green; font-weight: bold;">Offer: {{couponOffer}}%
                                </p>
                                <p class="card-text">Minimum Price: {{minAmount}}</p>
                                <p class="card-text">Maximum Price: {{maxAmount}}</p>
                                <p class="card-text"><strong>Valid Till:</strong> {{formatDate expireOn}}</p>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="product__pagination">
                    {{#if (gt currentPage 1)}}
                    <a href="/coupons?page={{subtract currentPage 1}}"><i class="fa fa-angle-left"></i></a>
                    {{/if}}

                    {{#each (range 1 totalPages)}}
                    <a href="/coupons?page={{this}}" class="{{#ifEquals this ../currentPage}}active{{/ifEquals}}">
                        {{this}}
                    </a>
                    {{/each}}

                    {{#if (lt currentPage totalPages)}}
                    <a href="/coupons?page={{add currentPage 1}}"><i class="fa fa-angle-right"></i></a>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>

</section>


{{> user/footer}}