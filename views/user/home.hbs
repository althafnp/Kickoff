{{> user/header}}



    <style>
        .container-fluid {
            padding: 0;
        }
        .hero-section {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: white;
        }
        .view-section {
            height: 10rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: white;
        }
        .inner-div {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px; 
        }
        .image-div {
            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        img {
            width: 100%; 
            height: 100%;
            object-fit: cover;
        }
        
        .collection {
            color: red;
            font-size: medium;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            letter-spacing: 1px;
        }

        .name {
            letter-spacing: 1px;
            font-size: xx-large;
        }

        .available {
            letter-spacing: 1px;
            font-size: medium;
        }

        .btn {
            width: 10rem;
            height: 3rem;
            background-color: #000;
            color: #fff;
            letter-spacing: 1px;
            border: 1px solid #000;
            border-radius: 2px;
            margin-top: 10px;
            transition: .3s ease-in-out;
        }

        .btn:hover {
            background-color: #fff;
            color: #000;
            cursor: pointer;
        }

        .view-more {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 10rem;
        }

        @media (max-width: 767px) {
            .hero-section {
                flex-direction: column;
                height: auto;
            }

            .inner-div, .image-div {
                width: 100%;
            }

            .image-div img {
                width: 100%;
                height: auto;
            }

            .view-more {
                margin-top: 20px;
                width: 100%;
            }
        }
    </style>

    <div class="container-fluid">
        <!-- FC Barcelona Section -->
        <div class="row no-gutters hero-section">
            <div class="col-12 col-md-7 inner-div">
                <p class="collection">2024-2025 COLLECTION</p>
                <h2 class="name">FC BARCELONA</h2>
                <p class="available">Available Now!</p>
                <a href="/shop"><button class="btn">SHOP NOW</button></a>
            </div>
            <div class="col-12 col-md-5 image-div">
                <img src="/images/Barcelona-home-cover.jpeg" alt="FC Barcelona Jersey">
            </div>
        </div>

        <!-- Real Madrid Section -->
        <div class="row no-gutters hero-section">
            <div class="col-12 col-md-5 image-div">
                <img src="/images/Realmadrid-home-cover.jpeg" alt="Real Madrid Jersey">
            </div>
            <div class="col-12 col-md-7 inner-div">
                <p class="collection">2024-2025 COLLECTION</p>
                <h2 class="name">REAL MADRID</h2>
                <p class="available">Available Now!</p>
                <a href="/shop"><button class="btn">SHOP NOW</button></a>
            </div>
        </div>

        <!-- Manchester City Section -->
        <div class="row no-gutters hero-section">
            <div class="col-12 col-md-7 inner-div">
                <p class="collection">2024-2025 COLLECTION</p>
                <h2 class="name">MANCHESTER CITY</h2>
                <p class="available">Available Now!</p>
                <a href="/shop"><button class="btn">SHOP NOW</button></a>
            </div>
            <div class="col-12 col-md-5 image-div">
                <img src="/images/Mancity-home-cover.jpeg" alt="Manchester City Jersey">
            </div>
        </div>
        <div class="row no-gutters view-section">
            <div class="view-more text-center">
                <a href="/shop"><button class="btn">VIEW MORE</button></a>
            </div>
        </div>
        
    </div>


    


{{> user/footer}}