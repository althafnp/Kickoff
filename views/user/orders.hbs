{{> user/header}}

<style>
    .cancel-order-btn {
        background-color: black;
        color: white;
        padding: 5px;
        font-size: small;
        border-radius: 2px;
        border: 1px solid black;
        transition: .3s ease-in-out;
        width: 100px;
    }

    .cancel-order-btn:hover {
        background-color: white;
        color: black;
    }

    .order-details-btn {
        background-color: black;
        color: white;
        padding: 5px 17px;
        font-size: small;
        border-radius: 2px;
        border: 1px solid black;
        transition: .3s ease-in-out;
        width: 100px;
    }

    .order-details-btn:hover {
        background-color: white;
        color: black;
    }
</style>

<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Orders</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <span>Orders</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="order-history spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                {{#if message}}
                <div style="text-align: center; margin-bottom: 10px">
                    <h4 style="font-weight: bold; color: rgb(241, 45, 45)">{{message}}</h4>
                </div>
                {{else}}
                <div class="order__table">
                    <!-- Card layout for mobile -->
                    <div class="d-block d-md-none">
                        <div class="row">
                            {{#each order}}
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Order ID: {{orderId}}</h5>
                                        <p class="card-text"><strong>Items:</strong> {{orderedItems.length}}</p>
                                        <p class="card-text"><strong>Total Price:</strong> ₹ {{finalAmount}}</p>
                                        <p class="card-text">
                                            <strong>Status:</strong>
                                            {{#if (eq paymentStatus 'Failed')}}
                                            <span class="text-danger">Payment Failed</span>
                                            {{else}}
                                            <span>{{status}}</span>
                                            {{/if}}
                                        </p>
                                        <div class="d-flex justify-content-between">
                                            {{#if (eq status 'Pending')}}
                                            <button class="btn btn-danger cancel-order-btn"
                                                data-order-id="{{_id}}">Cancel Order</button>
                                            {{/if}}
                                            <a href="/orders/details/{{id}}"
                                                class="btn btn-primary order-details-btn">View</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>

                    <!-- Table layout for larger screens -->
                    <div class="d-none d-md-block">
                        <table style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Order Id</th>
                                    <th>Items</th>
                                    <th>Total Price</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                            {{#each order}}
                                <tr style="height: 8rem;">
                                    <td class="product__cart__item">
                                        {{orderId}}
                                    </td>
                                    <td class="custom-quantity__item">
                                        <span>{{orderedItems.length}}</span>
                                    </td>
                                    <td>₹ {{finalAmount}}</td>
                                    <td class="order__status">
                                        {{#if (eq paymentStatus 'Failed')}}
                                        <span class="order-status" style="color: red;">Payment Failed</span>
                                        {{else}}
                                        <span class="order-status">{{status}}</span>
                                        {{/if}}
                                    </td>

                                    <td>
                                        {{#if (eq status 'Pending')}}
                                        <button class="cancel-order-btn" data-order-id="{{_id}}">Cancel Order</button>
                                        {{/if}}
                                    </td>


                                    <td>
                                        <a href="/orders/details/{{id}}" class="order-details-btn">View</a>
                                    </td>
                                </tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
                {{/if}}
                <div class="row" style="display: flex; justify-content: flex-end;">
                    <div class="col-lg-4">
                        <div class="order__summary">
                            <h6>Your Orders</h6>
                            <p>Total Orders: {{totalOrders}}</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-6">
                    <div class="continue__btn">
                        <a href="/shop">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="product__pagination">
                    {{#if (gt currentPage 1)}}
                    <a href="/orders?page={{subtract currentPage 1}}"><i class="fa fa-angle-left"></i></a>
                    {{/if}}

                    {{#each (range 1 totalPages)}}
                    <a href="/orders?page={{this}}" class="{{#ifEquals this ../currentPage}}active{{/ifEquals}}">
                        {{this}}
                    </a>
                    {{/each}}

                    {{#if (lt currentPage totalPages)}}
                    <a href="/orders?page={{add currentPage 1}}"><i class="fa fa-angle-right"></i></a>
                    {{/if}}
                </div>
            </div>
        </div>

    </div>

</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).on('click', '.cancel-order-btn', function () {
        const orderId = $(this).data('order-id');

        Swal.fire({
            title: 'Are you sure?',
            text: "Do you really want to cancel this order?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, cancel it!',
            cancelButtonText: 'No, keep it'
        }).then((result) => {
            if (result.isConfirmed) {

                $.ajax({
                    url: `/orders/cancel/${orderId}`,
                    method: 'POST',
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Order Cancelled',
                            text: response.message
                        }).then(() => {
                            location.reload();
                        });
                    },
                    error: function (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: error.responseJSON.message
                        });
                    }
                });
            }
        });
    });
</script>


{{> user/footer}}