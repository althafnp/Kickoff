{{> user/header}}


<style>
    .custom-pro-qty {
        display: flex;
        align-items: center;
    }

    .custom-qtybtn {
        background-color: #f0f0f0;
        height: 28px;
        padding: 0px 10px;
        cursor: pointer;
        font-size: 18px;
        user-select: none;
    }

    .custom-qtybtn:hover {
        background-color: #ddd;
    }

    .custom-cart-quantity {
        width: 40px;
        text-align: center;
        border: 1px solid #ddd;
        margin: 0 5px;
    }

    .toast-warning {
        background-color: #ffc107 !important;
        /* Typical warning color */
        color: #black !important;
        /* Text color */
    }

    /* Default styles for desktop/tablet */
.desktop-table {
    width: 100%;
    border-collapse: collapse;
}

.desktop-table th, .desktop-table td {
    padding: 15px;
    text-align: left;
}

/* Styles for mobile screens */
.mobile-card {
    display: none; /* Hide by default */
}

.card {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 10px;
    margin: 10px 0;
    display: flex;
    flex-direction: column;
}

.card-content {
    display: flex;
    flex-direction: column;
}

.product__cart__item__pic img {
    max-width: 100%;
    height: auto;
}

@media (max-width: 768px) {
    .desktop-table {
        display: none; /* Hide table on mobile */
    }
    .mobile-card {
        display: block; /* Show card layout on mobile */
    }
}
</style>

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Shopping Cart</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <a href="/shop">Shop</a>
                        <span>Shopping Cart</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<!-- Shopping Cart Section Begin -->
<section class="shopping-cart spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                {{#if message}}
                <div style="margin-bottom: 10px">
                    <h4 style="text-align: center; font-weight: bold; color: rgb(241, 45, 45)">{{message}}</h3>
                </div>
                {{else}}
                <div class="shopping__cart__table">
                    <table class="desktop-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each items}}
                            <tr>
                                <td class="product__cart__item">
                                    <div class="product__cart__item__pic" style="width: 5rem;">
                                        <img src="/uploads/re-image/{{this.productId.productImage.[0]}}" alt="">
                                    </div>
                                    <div class="product__cart__item__text">
                                        <h6>{{productId.productName}} - ({{size}})</h6>
                                        <h6>₹ {{productId.salePrice}}</h6>
                                    </div>
                                </td>
                                <td class="custom-quantity__item">
                                    <div class="custom-quantity">
                                        <div class="custom-pro-qty">
                                            <span class="custom-dec custom-qtybtn" data-id="{{_id}}">-</span>
                                            <input type="text" class="custom-cart-quantity" data-id="{{_id}}" min="1"
                                                value="{{quantity}}" disabled>
                                            <span class="custom-inc custom-qtybtn" data-id="{{_id}}">+</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="cart__price" data-id="{{_id}}">₹ {{totalPrice}}</td>
                                <td class="cart__close">
                                    <a href="/cart/remove/{{productId._id}}?size={{size}}" class="remove-item">
                                        <i class="fa fa-close"></i>
                                    </a>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>

                    <div class="mobile-card">
                        {{#each items}}
                        <div class="card">
                            <div class="card-content">
                                <div class="product__cart__item__pic">
                                    <img src="/uploads/re-image/{{this.productId.productImage.[0]}}" alt="">
                                </div>
                                <div class="product__cart__item__text">
                                    <h6>{{productId.productName}} - ({{size}})</h6>
                                    <h6>₹ {{productId.salePrice}}</h6>
                                </div>
                                <div class="custom-quantity">
                                    <div class="custom-pro-qty">
                                        <span class="custom-dec custom-qtybtn" data-id="{{_id}}">-</span>
                                        <input type="text" class="custom-cart-quantity" data-id="{{_id}}" min="1"
                                            value="{{quantity}}" disabled>
                                        <span class="custom-inc custom-qtybtn" data-id="{{_id}}">+</span>
                                    </div>
                                </div>
                                <div class="cart__price" data-id="{{_id}}">₹ {{totalPrice}}</div>
                                <div class="cart__close">
                                    <a href="/cart/remove/{{productId._id}}?size={{size}}" class="remove-item">
                                        <i class="fa fa-close"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <div class="continue__btn" style="margin-bottom: 2rem;">
                            <a href="/shop">Continue Shopping</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                {{#if items.length}}
                <div class="cart__total">
                    <h6>Cart total</h6>
                    <ul>
                        <li class="cart-total">Total <span>₹ </span></li>
                    </ul>
                    <a href="/checkout/{{cart._id}}" class="primary-btn" id="checkout">Proceed to checkout</a>
                </div>
                {{else}}
                {{/if}}
            </div>
        </div>
    </div>
</section>
<!-- Shopping Cart Section End -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>


<script>


    document.addEventListener('DOMContentLoaded', calculateTotal);

    $(document).ready(function () {
        // Increment button
        $('.custom-inc').on('click', function () {
            const input = $(this).siblings('.custom-cart-quantity');
            let quantity = parseInt(input.val());
            const itemId = input.data('id');

            if (quantity < 10) {
                quantity++;
                input.val(quantity);
                updateCartQuantity(itemId, quantity); // Call the AJAX function to update the quantity in the backend
            } else {
                toastr.warning('Quantity is limited for 10')
            }
        });

        // Decrement button
        $('.custom-dec').on('click', function () {
            const input = $(this).siblings('.custom-cart-quantity');
            let quantity = parseInt(input.val());
            const itemId = input.data('id');

            if (quantity > 1) {
                quantity--;
                input.val(quantity);
                updateCartQuantity(itemId, quantity); // Call the AJAX function to update the quantity in the backend
            }
        });

        // Function to update cart quantity via AJAX
        function updateCartQuantity(itemId, quantity) {
            $.ajax({
                url: '/cart/update-quantity',
                method: 'POST',
                data: {
                    itemId: itemId,
                    quantity: quantity
                },
                success: function (response) {
                    if (response.success) {
                        const totalPrice = response.newTotalPrice;
                        $(`.cart__price[data-id="${itemId}"]`).text(`₹ ${totalPrice}`);
                        calculateTotal()
                    } else {
                        alert(response.message);
                    }
                },
                error: function (error) {
                    toastr.error(error.responseJSON.message);
                }
            });
        }
    });

    function calculateTotal() {
    let total = 0;

    const priceCells = document.querySelectorAll('.cart__price');
    const halfLength = Math.floor(priceCells.length / 2);

    priceCells.forEach((cell, index) => {
        if (index < halfLength) {
            const priceText = cell.innerText.replace('₹ ', '');
            const price = parseFloat(priceText);
            total += price;
        }
    });

    const totalDisplay = document.querySelector('.cart-total');
    totalDisplay.innerHTML = `Total <span>₹ ${total.toFixed(2)}</span>`;
}
</script>


{{> user/footer}}