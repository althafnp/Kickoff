{{> user/header}}


<style>
    body {
        background-color: #f8f9fa;
    }

    .wallet-container {
        margin-top: 50px;
    }

    .balance-card {
        padding: 20px;
        border-radius: 10px;
        background-color: black;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }
</style>


<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Wallet</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <span>Wallet</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="container wallet-container">
    <div class="row">
        <div class="col-md-12">
            <div class="card balance-card">
                <h4 class="text-white" style="text-align: center;">Wallet Balance</h4>
                <h2 class="text-white" style="text-align: center;">₹{{user.wallet}}</h2>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <h4 class="card-title">Transaction History</h4>
            <div class="table-responsive">
                <table class="table table-bordered d-none d-md-table">
                    <thead class="thead-light">
                        <tr>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each transactions}}
                        <tr>
                            <td>{{type}}</td>
                            <td>{{description}}</td>
                            <td>₹{{amount}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                <div class="d-md-none">
                    {{#each transactions}}
                    <div class="card mb-2">
                        <div class="card-body">
                            <h5 class="card-title">{{type}}</h5>
                            <p class="card-text">{{description}}</p>
                            <p class="card-text"><strong>Amount:</strong> ₹{{amount}}</p>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
    <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-lg-12">
            <div class="product__pagination">
                {{#if (gt currentPage 1)}}
                <a href="/wallet?page={{subtract currentPage 1}}"><i class="fa fa-angle-left"></i></a>
                {{/if}}

                {{#each (range 1 totalPages)}}
                <a href="/wallet?page={{this}}" class="{{#ifEquals this ../currentPage}}active{{/ifEquals}}">
                    {{this}}
                </a>
                {{/each}}

                {{#if (lt currentPage totalPages)}}
                <a href="/wallet?page={{add currentPage 1}}"><i class="fa fa-angle-right"></i></a>
                {{/if}}
            </div>
        </div>
    </div>
</div>





{{> user/footer}}